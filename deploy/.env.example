# Settings for deploy/docker-compose.yml.
#   cp deploy/.env.example deploy/.env
# then fill in every empty value; Compose refuses to start while a required
# one is missing. deploy/.env is git-ignored.
#
# Generate each secret separately, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- QWED API server (required) ---
# Comma-separated origins allowed to call the API from a browser.
QWED_CORS_ORIGINS=http://localhost:3000
API_KEY_SECRET=
# Keep the next three stable: changing them invalidates issued tokens and
# API keys, or breaks the signed audit chain. The lookup secret must differ
# from the JWT secret.
QWED_JWT_SECRET_KEY=
QWED_API_KEY_LOOKUP_SECRET=
QWED_AUDIT_SECRET_KEY=
# User IDs allowed to read /metrics (see prometheus.yml). Empty denies all.
QWED_METRICS_OPERATOR_USER_IDS=

# --- Postgres (required) ---
POSTGRES_USER=qwed
POSTGRES_DB=qwed_db
POSTGRES_PASSWORD=
# Must match the three values above; "postgres" is the Compose service name.
DATABASE_URL=postgresql://qwed:<POSTGRES_PASSWORD>@postgres:5432/qwed_db

# --- Grafana (required) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
