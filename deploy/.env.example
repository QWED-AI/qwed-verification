# Settings for deploy/docker-compose.yml.
#   cp deploy/.env.example deploy/.env
# then fill in every empty value marked (required). The stack refuses to
# start while one of them is missing. QWED_METRICS_OPERATOR_USER_IDS is
# optional: leave it empty to deny every caller /metrics.
# deploy/.env is git-ignored.
#
# Generate each secret separately, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- QWED API server (required, except QWED_METRICS_OPERATOR_USER_IDS) ---
# Comma-separated origins allowed to call the API from a browser.
QWED_CORS_ORIGINS=http://localhost:3000
API_KEY_SECRET=
# Keep the next three stable: changing them invalidates issued tokens and
# API keys, or breaks the signed audit chain. The lookup secret must differ
# from the JWT secret.
QWED_JWT_SECRET_KEY=
QWED_API_KEY_LOOKUP_SECRET=
QWED_AUDIT_SECRET_KEY=
# Optional, recommended. The EC P-256 attestation signing key as PEM, with
# newlines written as \n (see the root .env.example for how to generate
# one). Unset, each process generates its own, and its attestations cannot
# be verified after a restart or by another replica.
# QWED_SIGNING_KEY=
# Optional. How long an attestation stays valid, in seconds: 60 to 2592000
# (30 days); unset is 86400 (24 hours). Anything else stops the server.
# QWED_ATTESTATION_TTL_SECONDS=86400
# Optional. User IDs allowed to read /metrics (see prometheus.yml).
# Empty denies every caller.
QWED_METRICS_OPERATOR_USER_IDS=

# --- Postgres (required) ---
POSTGRES_USER=qwed
POSTGRES_DB=qwed_db
POSTGRES_PASSWORD=
# Must match the three values above; "postgres" is the Compose service name:
#   postgresql://qwed:<POSTGRES_PASSWORD>@postgres:5432/qwed_db
DATABASE_URL=

# --- Grafana (required) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
