        "lint": "eslint src/**/*.ts",
        "prepublish": "npm run build"
    },
    "dependencies": {},
    "devDependencies": {
        "typescript": "^7.0.2",
        "tsup": "^8.0.0",
        "vitest": "^5.0.2",
        "@types/node": "^26.6.2",
        "eslint": "^10.11.0",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "overrides": {
        "minimatch": "9.0.9",
        "esbuild": ">=0.28.1 <0.29.0"
    }
