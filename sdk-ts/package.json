{
    "name": "@qwed-ai/sdk",
    "version": "7.2.1",
    "description": "TypeScript SDK for QWED Verification Protocol",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "https://github.com/QWED-AI/qwed-verification.git",
        "directory": "sdk-ts"
    },
    "keywords": [
        "qwed",
        "verification",
        "ai",
        "llm",
        "trust",
        "symbolic"
    ],
    "author": "QWED-AI",
    "license": "Apache-2.0",
    "scripts": {
